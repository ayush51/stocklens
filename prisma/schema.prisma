// StockLens data model.
// Design rationale: docs/phase-0/04-database-design.md and docs/phase-0/05-prisma-schema.md
// Connection URLs live in prisma.config.ts (Prisma 7) — see .agents/skills/prisma-upgrade-v7.
//
// Deviation from the Phase 0 design doc: Company.ticker uses a plain unique
// String instead of `citext`, to avoid requiring a Postgres extension during
// initial scaffolding. Normalization (uppercase, trimmed) is enforced at the
// application layer (features/companies/server) before every read/write.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identity & tenancy
// ─────────────────────────────────────────────────────────────
model User {
  id          String   @id @db.Uuid // mirrors auth.users.id
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  memberships WorkspaceMember[]
  auditLogs   AuditLog[]
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  members                WorkspaceMember[]
  portfolios             Portfolio[]
  theses                 Thesis[]
  earningsReviews        EarningsReview[]
  alertRules             AlertRule[]
  aiSummaries            AISummary[]
  auditLogs              AuditLog[]
  decisionJournalEntries DecisionJournalEntry[]
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Portfolios & positions
// ─────────────────────────────────────────────────────────────
enum PortfolioSource {
  MANUAL
  CSV_IMPORT
  ROBINHOOD_SYNC
}

model Portfolio {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  name        String
  source      PortfolioSource @default(MANUAL)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  holdings            Holding[]
  transactions        Transaction[]
  brokerageConnection BrokerageConnection?
  csvImportJobs       CsvImportJob[]

  @@index([workspaceId])
}

model Holding {
  id               String   @id @default(uuid()) @db.Uuid
  portfolioId      String   @db.Uuid
  companyId        String   @db.Uuid
  quantity         Decimal  @db.Decimal(20, 6)
  averageCost      Decimal  @db.Decimal(20, 4)
  // Cumulative realized P&L across the full transaction history — see
  // computeHoldingAggregate. Not tax-authoritative; see disclaimers.
  realizedGainLoss Decimal  @default(0) @db.Decimal(20, 4)
  updatedAt        DateTime @updatedAt

  portfolio              Portfolio              @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company                Company                @relation(fields: [companyId], references: [id])
  thesis                 Thesis?
  decisionJournalEntries DecisionJournalEntry[]

  @@unique([portfolioId, companyId])
  @@index([companyId])
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  DIVIDEND_REINVESTMENT
  DEPOSIT
  WITHDRAWAL
  FEE
  INTEREST
  SPLIT
  TRANSFER_IN
  TRANSFER_OUT
}

model Transaction {
  id             String          @id @default(uuid()) @db.Uuid
  portfolioId    String          @db.Uuid
  companyId      String?         @db.Uuid // null for cash-only rows (deposit/withdrawal/fee/interest)
  csvImportJobId String?         @db.Uuid
  type           TransactionType
  // quantity/price are null for cash-only rows — use `amount` instead.
  quantity       Decimal?        @db.Decimal(20, 6)
  price          Decimal?        @db.Decimal(20, 4)
  // Cash amount — the authoritative value for cash-only rows, and an
  // optional cross-check (should equal quantity*price+fees) for share rows.
  amount         Decimal?        @db.Decimal(20, 4)
  fees           Decimal?        @db.Decimal(20, 4)
  occurredAt     DateTime
  source         PortfolioSource @default(MANUAL)
  externalId     String? // broker/CSV-provided id, or a deterministic hash of row content for CSV imports — for idempotent re-sync/re-import
  createdAt      DateTime        @default(now())

  portfolio    Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id])
  csvImportJob CsvImportJob? @relation(fields: [csvImportJobId], references: [id])

  @@unique([portfolioId, externalId])
  @@index([portfolioId, occurredAt])
}

enum BrokerageConnectionStatus {
  CONNECTED
  NEEDS_REAUTH
  DISCONNECTED
  ERROR
}

model BrokerageConnection {
  id            String                    @id @default(uuid()) @db.Uuid
  portfolioId   String                    @unique @db.Uuid
  provider      String                    @default("ROBINHOOD")
  status        BrokerageConnectionStatus @default(CONNECTED)
  // Null under the MCP-assisted sync model: there is no credential for the
  // app to reference, since the app never authenticates to the brokerage
  // itself (see ROBINHOOD_MCP_SECURITY_PLAN.md). Reserved for a future
  // self-service connect flow, which would populate a real secret-store
  // reference here — never the credential itself.
  credentialRef String?
  scopes        String[] // e.g. ["read:positions", "read:transactions"] — write scopes never issued
  lastSyncedAt  DateTime?
  createdAt     DateTime                  @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

enum CsvImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CsvImportJob {
  id            String          @id @default(uuid()) @db.Uuid
  portfolioId   String          @db.Uuid
  status        CsvImportStatus @default(PENDING)
  filename      String
  // SHA-256 of the uploaded file — proves re-import detection and gives an
  // audit trail without storing the file itself (spec: "store the source
  // filename and import checksum, not the raw file unless retention is
  // explicitly enabled"). The raw file is parsed entirely client-side and
  // never uploaded to the server at all.
  checksum      String
  // Reserved for a future explicit-retention opt-in — unused today.
  storagePath   String?
  columnMapping Json
  rowsTotal     Int?
  rowsSucceeded Int?
  rowsDuplicate Int?
  rowsFailed    Int?
  errorDetail   Json?
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
  rolledBackAt  DateTime?

  portfolio    Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([portfolioId])
}

// ─────────────────────────────────────────────────────────────
enum CompanyAssetType {
  STOCK
  ETF
}

// Company & market data — GLOBAL reference data (no workspaceId)
// ─────────────────────────────────────────────────────────────
model Company {
  id        String           @id @default(uuid()) @db.Uuid
  ticker    String           @unique // normalized (uppercase, trimmed) at the application layer
  cik       String?          @unique // null for ETFs — SEC's operating-company ticker list doesn't cover funds
  name      String
  assetType CompanyAssetType @default(STOCK)
  exchange  String?
  sector    String?
  industry  String?
  updatedAt DateTime         @updatedAt

  holdings               Holding[]
  transactions           Transaction[]
  priceSnapshots         PriceSnapshot[]
  financialStatements    FinancialStatement[]
  secFilings             SecFiling[]
  earningsEvents         EarningsEvent[]
  theses                 Thesis[]
  metricTemplate         CompanyMetricTemplate?
  decisionJournalEntries DecisionJournalEntry[]
  aiSummaries            AISummary[]

  // Signal Convergence — see the section below. Company doubles as the
  // spec's "PublicCompany": it already has ticker/cik/name/sector/industry,
  // and PriceSnapshot already covers "MarketPriceSnapshot" — reused rather
  // than duplicated (instructions.md §4 "do not create duplicate models").
  aliases                        CompanyAlias[]
  relationshipsAsParent          CompanyRelationship[]           @relation("RelationshipFrom")
  relationshipsAsSubsidiary      CompanyRelationship[]           @relation("RelationshipTo")
  suggestedInResolutions         EntityResolutionReview[]        @relation("SuggestedCompany")
  resolvedInResolutions          EntityResolutionReview[]        @relation("ResolvedCompany")
  governmentContractEvents       GovernmentContractEvent[]
  insiderTransactionEvents       InsiderTransactionEvent[]
  congressionalTransactionEvents CongressionalTransactionEvent[]
  signalSnapshots                SignalSnapshot[]
}

model PriceSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  asOfDate  DateTime @db.Date
  open      Decimal? @db.Decimal(20, 4)
  high      Decimal? @db.Decimal(20, 4)
  low       Decimal? @db.Decimal(20, 4)
  close     Decimal  @db.Decimal(20, 4)
  volume    BigInt?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, asOfDate])
}

enum FiscalPeriod {
  Q1
  Q2
  Q3
  Q4
  FY
}

model FinancialStatement {
  id                       String       @id @default(uuid()) @db.Uuid
  companyId                String       @db.Uuid
  fiscalYear               Int
  fiscalPeriod             FiscalPeriod
  revenue                  Decimal?     @db.Decimal(24, 2)
  netIncome                Decimal?     @db.Decimal(24, 2)
  grossProfit              Decimal?     @db.Decimal(24, 2)
  eps                      Decimal?     @db.Decimal(10, 4)
  totalAssets              Decimal?     @db.Decimal(24, 2)
  totalLiabilities         Decimal?     @db.Decimal(24, 2)
  // No totalDebt/netDebt column: real EDGAR XBRL debt tags vary too
  // inconsistently across companies (verified live 2026-07-30 — NVDA
  // reports LongTermDebtNoncurrent + DebtCurrent separately, ORCL reports
  // one combined LongTermDebt) to sum reliably into one figure without a
  // real risk of double- or under-counting. See edgar-xbrl/index.ts.
  operatingIncome          Decimal?     @db.Decimal(24, 2)
  operatingCashFlow        Decimal?     @db.Decimal(24, 2)
  capitalExpenditures      Decimal?     @db.Decimal(24, 2)
  cashAndEquivalents       Decimal?     @db.Decimal(24, 2)
  stockBasedCompensation   Decimal?     @db.Decimal(24, 2)
  dividendsPaid            Decimal?     @db.Decimal(24, 2)
  buybacks                 Decimal?     @db.Decimal(24, 2)
  dilutedSharesOutstanding Decimal?     @db.Decimal(20, 0)
  sourceUrl                String?
  fetchedAt                DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, fiscalYear, fiscalPeriod])
}

// ─────────────────────────────────────────────────────────────
// Company-specific metric templates — curated KPIs beyond the universal
// fundamentals in FinancialStatement (e.g. Oracle's RPO growth, Meta's
// DAP, Nvidia's Data Center revenue). Templates are DATA, not application
// branches — no ticker-specific logic lives in UI components; everything
// company-specific is a row here. GLOBAL reference data like Company/
// FinancialStatement (no workspaceId, public_read RLS policy, writes via
// the service-role client) — a KPI template for Oracle describes Oracle
// objectively, it isn't one user's private data. Per-workspace template
// customization would be a future refinement if multi-user support ever
// needs it (see docs/phase-0/09-security-model.md's tenant-vs-global
// split).
// ─────────────────────────────────────────────────────────────
enum MetricTemplateSource {
  CURATED // hand-written, shipped with the app (e.g. the ORCL/META/NVDA seed templates)
  AI_PROPOSED // generated by the AI-assisted setup flow, pending or after user approval
  USER
}

model MetricDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // stable slug, e.g. "oci_revenue"
  label       String
  description String?
  unit        String // "USD" | "PERCENT" | "COUNT" | "TEXT" | ...
  createdAt   DateTime @default(now())

  templateItems CompanyMetricTemplateItem[]
}

model CompanyMetricTemplate {
  id        String               @id @default(uuid()) @db.Uuid
  companyId String               @unique @db.Uuid
  name      String
  source    MetricTemplateSource @default(CURATED)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  company Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   CompanyMetricTemplateItem[]
}

model CompanyMetricTemplateItem {
  id                 String  @id @default(uuid()) @db.Uuid
  templateId         String  @db.Uuid
  metricDefinitionId String  @db.Uuid
  displayOrder       Int     @default(0)
  /// Company-specific rationale — distinct from MetricDefinition.description,
  /// which is the generic definition shared across any template using it.
  whyItMatters       String?
  reportedIn         String? // e.g. "10-Q MD&A", "quarterly earnings deck"

  template         CompanyMetricTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  metricDefinition MetricDefinition      @relation(fields: [metricDefinitionId], references: [id])
  observations     MetricObservation[]

  @@unique([templateId, metricDefinitionId])
}

enum MetricConfidence {
  REPORTED // directly from an official filing/IR release
  ESTIMATED // derived or estimated, not a directly reported figure
  UNVERIFIED // AI-proposed or otherwise not yet confirmed against a source
}

model MetricObservation {
  id               String           @id @default(uuid()) @db.Uuid
  templateItemId   String           @db.Uuid
  fiscalYear       Int
  fiscalPeriod     FiscalPeriod
  // Kept as a string, not Decimal: some company-specific KPIs are
  // qualitative (e.g. "data-centre capacity commentary"), not numeric.
  value            String
  unit             String
  source           String? // URL or citation text
  confidence       MetricConfidence @default(REPORTED)
  isManualOverride Boolean          @default(false)
  recordedAt       DateTime         @default(now())

  templateItem CompanyMetricTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Cascade)

  @@unique([templateItemId, fiscalYear, fiscalPeriod])
  @@index([templateItemId])
}

model SecFiling {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  formType        String // "10-K", "10-Q", "8-K", …
  accessionNumber String    @unique
  filedAt         DateTime
  periodOfReport  DateTime?
  documentUrl     String
  fetchedAt       DateTime  @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aiSummaries AISummary[]

  @@index([companyId, filedAt])
}

enum ProviderCallStatus {
  SUCCESS
  ERROR
}

// Global/operational, not tenant data — instructions.md §13 provider
// resilience tracking. Deliberately narrow: no "freshness" field (already
// covered per-quote via isQuoteStale) and no cross-provider "data
// disagreements" tracking (there's only ever one active provider per data
// type right now, so there's nothing to disagree with yet).
model ProviderCallLog {
  id            String             @id @default(uuid()) @db.Uuid
  provider      String // "finnhub" | "edgar-xbrl" | "yahoo"
  operation     String // endpoint path or method name
  requestedAt   DateTime           @default(now())
  durationMs    Int
  status        ProviderCallStatus
  errorCategory String?
  rateLimited   Boolean            @default(false)
  usedFallback  Boolean            @default(false)

  @@index([provider, requestedAt])
}

model EarningsEvent {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String       @db.Uuid
  fiscalYear      Int
  fiscalPeriod    FiscalPeriod
  reportDate      DateTime
  epsEstimate     Decimal?     @db.Decimal(10, 4)
  epsActual       Decimal?     @db.Decimal(10, 4)
  revenueEstimate Decimal?     @db.Decimal(24, 2)
  revenueActual   Decimal?     @db.Decimal(24, 2)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviews     EarningsReview[]
  aiSummaries AISummary[]

  @@unique([companyId, fiscalYear, fiscalPeriod])
  @@index([companyId, reportDate])
}

// ─────────────────────────────────────────────────────────────
// Thesis & review — tenant-owned
// ─────────────────────────────────────────────────────────────
enum ConvictionLevel {
  LOW
  MEDIUM
  HIGH
}

// Matches instructions.md §8's named statuses exactly, not an ad hoc
// taxonomy — was ACTIVE/NEEDS_REVIEW/CLOSED until 2026-07-29, changed
// while zero real Thesis rows existed yet (verified before migrating),
// so this was a clean rename, not a data migration.
enum ThesisStatus {
  UNREVIEWED
  ON_TRACK
  WATCH
  WEAKENED
  BROKEN
  EXITED
}

model Thesis {
  id                      String          @id @default(uuid()) @db.Uuid
  workspaceId             String          @db.Uuid
  companyId               String          @db.Uuid
  holdingId               String?         @unique @db.Uuid
  title                   String          @default("")
  summary                 String
  // "Why the market may be mispricing the company" — the core contrarian
  // claim, kept distinct from `summary` (which is the general thesis
  // overview) per the spec's explicit field list.
  whyMispriced            String?
  expectedDrivers         String?
  risks                   String?
  keyAssumptions          String?
  timeHorizon             String? // free text ("12-24 months") — horizons vary too much for a fixed enum
  valuationNotes          String?
  positionSizingRationale String?
  reasonsToAdd            String?
  reasonsToHold           String?
  reasonsToTrim           String?
  reasonsToExit           String?
  invalidationConditions  String?
  nextReviewDate          DateTime?       @db.Date
  sources                 String[]        @default([])
  conviction              ConvictionLevel @default(MEDIUM)
  targetPrice             Decimal?        @db.Decimal(20, 4)
  status                  ThesisStatus    @default(UNREVIEWED)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company           @relation(fields: [companyId], references: [id])
  holding     Holding?          @relation(fields: [holdingId], references: [id])
  revisions   ThesisRevision[]
  aiSummaries AISummary[]
  criteria    ThesisCriterion[]

  @@index([workspaceId])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────
// Thesis scorecard — configurable Green/Watch/Red criteria. Tenant data
// (scoped through Thesis -> Workspace), unlike MetricDefinition/
// CompanyMetricTemplate which are global reference data: a criterion and
// its threshold judgment calls belong to one workspace's thesis, not to
// the company objectively.
// ─────────────────────────────────────────────────────────────
enum CriterionDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum CriterionRuleType {
  NUMERIC_THRESHOLD
  PERCENT_GROWTH_THRESHOLD
  SEQUENTIAL_CHANGE
  YEAR_OVER_YEAR_CHANGE
  CONSECUTIVE_DETERIORATION
  BOOLEAN_EVENT
  QUALITATIVE_MANUAL
}

model ThesisCriterion {
  id                           String             @id @default(uuid()) @db.Uuid
  thesisId                     String             @db.Uuid
  metricLabel                  String
  direction                    CriterionDirection @default(HIGHER_IS_BETTER)
  ruleType                     CriterionRuleType
  greenRule                    String // human-readable description, e.g. "RPO growth >= 20% YoY"
  watchRule                    String
  redRule                      String
  // Numeric boundaries feeding suggestCriterionStatus() — null for
  // BOOLEAN_EVENT/QUALITATIVE_MANUAL criteria, which never auto-suggest.
  greenThreshold               Decimal?           @db.Decimal(20, 4)
  watchThreshold               Decimal?           @db.Decimal(20, 4)
  evaluationPeriod             String             @default("Quarterly")
  consecutivePeriodRequirement Int                @default(1)
  displayOrder                 Int                @default(0)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  thesis      Thesis             @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  evaluations ThesisEvaluation[]

  @@index([thesisId])
}

enum CriterionStatus {
  GREEN
  WATCH
  RED
  INSUFFICIENT_DATA
}

model ThesisEvaluation {
  id               String          @id @default(uuid()) @db.Uuid
  criterionId      String          @db.Uuid
  fiscalYear       Int
  fiscalPeriod     FiscalPeriod
  currentValue     String?
  previousValue    String?
  status           CriterionStatus @default(INSUFFICIENT_DATA)
  explanation      String?
  source           String?
  overrideReason   String?
  isManualOverride Boolean         @default(false)
  evaluatedAt      DateTime        @default(now())

  criterion ThesisCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([criterionId, fiscalYear, fiscalPeriod])
  @@index([criterionId, fiscalYear, fiscalPeriod])
}

// ─────────────────────────────────────────────────────────────
// Decision journal — required record-keeping for major portfolio
// decisions, aimed at making emotionally-driven buying/averaging-
// down/panic-selling visible after the fact. Tenant data.
// ─────────────────────────────────────────────────────────────
enum DecisionAction {
  BUY
  ADD
  HOLD
  TRIM
  EXIT
  WATCH
}

enum DecisionEmotion {
  CONFIDENT
  ANXIOUS
  FOMO
  REGRET
  NEUTRAL
  EXCITED
  FEARFUL
}

model DecisionJournalEntry {
  id                                      String           @id @default(uuid()) @db.Uuid
  workspaceId                             String           @db.Uuid
  companyId                               String           @db.Uuid
  holdingId                               String?          @db.Uuid
  decisionDate                            DateTime         @db.Date
  action                                  DecisionAction
  proposedAmount                          Decimal?         @db.Decimal(20, 4)
  evidenceSupporting                      String?
  evidenceOpposing                        String?
  currentEmotion                          DecisionEmotion?
  confidence                              ConvictionLevel?
  thesisImpact                            String?
  positionSizeImpact                      String?
  taxConsiderationNotes                   String?
  whatWouldChangeDecision                 String?
  // Pre-add behavioral checklist (spec: "before recording an add
  // decision, ask…") — null when the action isn't BUY/ADD, since the
  // checklist doesn't apply to a trim/exit/watch/hold entry.
  wouldBuyIfOwnedNone                     Boolean?
  buyingBecauseThesisImprovedNotPriceDrop Boolean?
  belowAllocationCeiling                  Boolean?
  portfolioAdequatelyDiversified          Boolean?
  newEvidenceForPurchase                  String?
  evidenceThatWouldProveWrong             String?
  reviewDate                              DateTime?        @db.Date
  finalAction                             String? // what was actually done — may differ from `action`, filled in later
  outcomeNotes                            String?
  createdAt                               DateTime         @default(now())
  updatedAt                               DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id])
  holding   Holding?  @relation(fields: [holdingId], references: [id])

  @@index([workspaceId, decisionDate])
  @@index([companyId])
}

enum ThesisRevisionTrigger {
  MANUAL_EDIT
  EARNINGS_REVIEW
  FILING_REVIEW
}

// Immutable full snapshot of a Thesis at one point in time — never updated
// or deleted after creation. Every edit to Thesis inserts one of these
// first, so "what changed between versions" is always answerable by diffing
// two rows, not by reconstructing history from an audit log.
model ThesisRevision {
  id                      String                @id @default(uuid()) @db.Uuid
  thesisId                String                @db.Uuid
  title                   String                @default("")
  summary                 String
  whyMispriced            String?
  expectedDrivers         String?
  risks                   String?
  keyAssumptions          String?
  timeHorizon             String?
  valuationNotes          String?
  positionSizingRationale String?
  reasonsToAdd            String?
  reasonsToHold           String?
  reasonsToTrim           String?
  reasonsToExit           String?
  invalidationConditions  String?
  nextReviewDate          DateTime?             @db.Date
  sources                 String[]              @default([])
  conviction              ConvictionLevel
  targetPrice             Decimal?              @db.Decimal(20, 4)
  trigger                 ThesisRevisionTrigger @default(MANUAL_EDIT)
  createdAt               DateTime              @default(now())

  thesis         Thesis          @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  earningsReview EarningsReview?

  @@index([thesisId, createdAt])
}

model EarningsReview {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  earningsEventId   String   @db.Uuid
  notes             String
  affectsThesis     Boolean  @default(false)
  spawnedRevisionId String?  @unique @db.Uuid
  createdAt         DateTime @default(now())

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  earningsEvent   EarningsEvent   @relation(fields: [earningsEventId], references: [id], onDelete: Cascade)
  spawnedRevision ThesisRevision? @relation(fields: [spawnedRevisionId], references: [id])

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// Alerts — tenant-owned
// ─────────────────────────────────────────────────────────────
enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  NEW_FILING
  UPCOMING_EARNINGS
  THESIS_STALE
}

model AlertRule {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  companyId   String?   @db.Uuid
  thesisId    String?   @db.Uuid
  type        AlertType
  config      Json // e.g. { "threshold": 150.00 } or { "daysBefore": 3 }
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    AlertEvent[]

  @@index([workspaceId])
  @@index([active, type])
}

enum AlertDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum AlertChannel {
  EMAIL
  IN_APP
}

model AlertEvent {
  id             String              @id @default(uuid()) @db.Uuid
  alertRuleId    String              @db.Uuid
  payload        Json
  channel        AlertChannel
  deliveryStatus AlertDeliveryStatus @default(PENDING)
  firedAt        DateTime            @default(now())
  deliveredAt    DateTime?

  alertRule AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)

  @@index([alertRuleId, firedAt])
}

// ─────────────────────────────────────────────────────────────
// AI summaries — tenant-owned, content-addressed cache
// ─────────────────────────────────────────────────────────────
enum AISummarySubjectType {
  SEC_FILING
  EARNINGS_EVENT
  THESIS
  COMPANY_FINANCIALS
}

model AISummary {
  id              String               @id @default(uuid()) @db.Uuid
  // Null for SEC_FILING/EARNINGS_EVENT/COMPANY_FINANCIALS summaries — those
  // are objectively about global-reference-data (like FinancialStatement),
  // generated once and cached for every workspace, not duplicated per
  // tenant. Set only for THESIS summaries, which are genuinely
  // workspace-specific. See ai-summaries/server/*.
  workspaceId     String?              @db.Uuid
  subjectType     AISummarySubjectType
  secFilingId     String?              @db.Uuid
  earningsEventId String?              @db.Uuid
  thesisId        String?              @db.Uuid
  // Set only for COMPANY_FINANCIALS — keyed by company, not a single
  // FinancialStatement row, since the summary covers the last several
  // reported periods together.
  companyId       String?              @db.Uuid
  inputHash       String // hash(subject content + prompt version + model id)
  model           String
  promptVersion   String
  content         String
  createdAt       DateTime             @default(now())

  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  secFiling     SecFiling?     @relation(fields: [secFilingId], references: [id])
  earningsEvent EarningsEvent? @relation(fields: [earningsEventId], references: [id])
  thesis        Thesis?        @relation(fields: [thesisId], references: [id])
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([subjectType, secFilingId, earningsEventId, thesisId, companyId, inputHash])
}

// ─────────────────────────────────────────────────────────────
// Cross-cutting
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  action      String // "BROKERAGE_CONNECTED", "WORKSPACE_MEMBER_ADDED", …
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([workspaceId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Signal Convergence — global reference data, same footing as
// Company/FinancialStatement/EarningsEvent: one government contract or
// insider transaction is the same real-world fact for every user, not
// tenant data. Public-read RLS, service-role writes — see the
// rls_and_roles-style grant added in this feature's migration.
// ─────────────────────────────────────────────────────────────

enum CompanyAliasType {
  LEGAL_NAME
  FORMER_NAME
  DBA
  GOVERNMENT_CONTRACTOR_NAME
  MANUAL_ALIAS
}

// Maps a raw name string as it appears in an external source (a USAspending
// recipient name, a congressional disclosure's asset name) to a resolved
// Company — the mechanism behind entity resolution for both government
// contracts and congressional trades, which rarely report a ticker directly.
model CompanyAlias {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @db.Uuid
  alias     String
  aliasType CompanyAliasType
  source    String // e.g. "usaspending", "manual"
  verified  Boolean          @default(false)
  notes     String?
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, alias, aliasType])
  @@index([alias])
}

enum CompanyRelationshipType {
  PARENT_OF
  SUBSIDIARY_OF
}

// A government contract awarded to a subsidiary may only map to a public
// company via its parent — this is what lets the UI say "Contract
// recipient: [subsidiary]. Public parent association: [ticker]." instead
// of silently treating the subsidiary as if it were the public company.
model CompanyRelationship {
  id               String                  @id @default(uuid()) @db.Uuid
  fromCompanyId    String                  @db.Uuid
  toCompanyId      String                  @db.Uuid
  relationshipType CompanyRelationshipType
  confidence       Decimal                 @db.Decimal(3, 2)
  verified         Boolean                 @default(false)
  notes            String?
  createdAt        DateTime                @default(now())

  fromCompany Company @relation("RelationshipFrom", fields: [fromCompanyId], references: [id], onDelete: Cascade)
  toCompany   Company @relation("RelationshipTo", fields: [toCompanyId], references: [id], onDelete: Cascade)

  @@unique([fromCompanyId, toCompanyId, relationshipType])
}

enum ResolutionSourceType {
  GOVERNMENT_CONTRACT
  CONGRESSIONAL_TRANSACTION
}

enum ResolutionReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// A queue of raw names that didn't resolve with enough confidence to
// auto-map — "never force a ticker match when confidence is low" means
// low-confidence events sit here, unlinked, until a human confirms or
// rejects the suggestion, rather than silently guessing.
model EntityResolutionReview {
  id                  String                 @id @default(uuid()) @db.Uuid
  sourceType          ResolutionSourceType
  // Loose reference (no FK) — this row can point at either
  // GovernmentContractEvent or CongressionalTransactionEvent depending on
  // sourceType, which Postgres/Prisma can't express as a single typed FK.
  sourceRecordId      String                 @db.Uuid
  rawName             String
  suggestedCompanyId  String?                @db.Uuid
  suggestedConfidence Decimal?               @db.Decimal(3, 2)
  status              ResolutionReviewStatus @default(PENDING)
  resolvedCompanyId   String?                @db.Uuid
  notes               String?
  createdAt           DateTime               @default(now())
  resolvedAt          DateTime?

  suggestedCompany Company? @relation("SuggestedCompany", fields: [suggestedCompanyId], references: [id])
  resolvedCompany  Company? @relation("ResolvedCompany", fields: [resolvedCompanyId], references: [id])

  @@unique([sourceType, sourceRecordId])
  @@index([status])
}

enum ContractRecordType {
  NEW_AWARD
  MODIFICATION
  DE_OBLIGATION
  CORRECTION
}

model GovernmentContractEvent {
  id                   String             @id @default(uuid()) @db.Uuid
  externalId           String // USAspending generated_unique_award_id
  modificationNumber   String?
  recipientLegalName   String
  parentRecipientName  String?
  awardingAgency       String
  description          String?
  awardType            String
  recordType           ContractRecordType
  actionDate           DateTime           @db.Date
  startDate            DateTime?          @db.Date
  endDate              DateTime?          @db.Date
  currentAwardAmount   Decimal?           @db.Decimal(20, 2)
  newlyObligatedAmount Decimal?           @db.Decimal(20, 2)
  potentialAwardAmount Decimal?           @db.Decimal(20, 2)

  resolvedCompanyId    String?  @db.Uuid
  resolutionMethod     String?
  resolutionConfidence Decimal? @db.Decimal(3, 2)

  sourceUrl      String?
  sourceName     String   @default("usaspending")
  firstSeenAt    DateTime @default(now())
  lastUpdatedAt  DateTime @updatedAt
  parsingVersion Int      @default(1)
  rawPayload     Json?

  resolvedCompany Company? @relation(fields: [resolvedCompanyId], references: [id])

  @@unique([externalId, modificationNumber])
  @@index([resolvedCompanyId, actionDate])
  @@index([actionDate])
}

enum InsiderRelationshipCategory {
  DIRECTOR
  OFFICER
  TEN_PERCENT_OWNER
  OTHER
}

enum InsiderTransactionClassification {
  OPEN_MARKET_PURCHASE
  OPEN_MARKET_SALE
  OPTION_EXERCISE
  AWARD_OR_GRANT
  GIFT
  TAX_WITHHOLDING
  AUTOMATIC_OR_PLANNED
  OTHER
}

// One row per transaction line item within a Form 3/4/4A/5/5A filing — a
// single filing (accessionNumber) commonly reports several transactions.
model InsiderTransactionEvent {
  id         String @id @default(uuid()) @db.Uuid
  issuerCik  String
  issuerName String

  reportingPersonName  String
  reportingPersonTitle String?
  relationshipCategory InsiderRelationshipCategory

  transactionDate DateTime                         @db.Date
  filingDate      DateTime                         @db.Date
  transactionCode String // raw Form 4 code — "P", "S", "A", "M", "G", "F", …
  classification  InsiderTransactionClassification
  isPurchase      Boolean? // null when the code isn't a buy/sell (e.g. a grant)

  shares              Decimal? @db.Decimal(20, 4)
  pricePerShare       Decimal? @db.Decimal(20, 4)
  estimatedTotalValue Decimal? @db.Decimal(24, 2)
  ownershipType       String // "D" direct / "I" indirect
  sharesOwnedAfter    Decimal? @db.Decimal(20, 4)
  is10b51Plan         Boolean  @default(false)
  isAmendment         Boolean  @default(false)

  resolvedCompanyId String? @db.Uuid // resolved via issuerCik — see CIK-based resolution, near-certain when set

  accessionNumber String
  lineIndex       Int // position within the filing's transaction list — dedup key component, since one filing has many lines
  filingUrl       String

  sourceName     String   @default("sec_edgar")
  firstSeenAt    DateTime @default(now())
  lastUpdatedAt  DateTime @updatedAt
  parsingVersion Int      @default(1)
  rawPayload     Json?

  resolvedCompany Company? @relation(fields: [resolvedCompanyId], references: [id])

  @@unique([accessionNumber, lineIndex])
  @@index([resolvedCompanyId, transactionDate])
  @@index([issuerCik, transactionDate])
}

enum CongressChamber {
  HOUSE
  SENATE
}

enum CongressOwner {
  SELF
  SPOUSE
  DEPENDENT
  JOINT
  UNKNOWN
}

enum CongressTransactionType {
  PURCHASE
  SALE
  EXCHANGE
  UNKNOWN
}

// sourceName/isLiveOfficialSource exist specifically so the UI can never
// silently present manual-import or sample-fixture rows as live official
// disclosures — see this feature's congressional provider doc comment.
model CongressionalTransactionEvent {
  id             String          @id @default(uuid()) @db.Uuid
  politicianName String
  chamber        CongressChamber
  state          String?
  party          String?
  owner          CongressOwner   @default(UNKNOWN)

  assetNameDisclosed   String
  resolvedCompanyId    String?  @db.Uuid
  resolutionMethod     String?
  resolutionConfidence Decimal? @db.Decimal(3, 2)

  transactionType     CongressTransactionType
  transactionDate     DateTime                @db.Date
  filingDate          DateTime                @db.Date
  disclosureDelayDays Int

  reportedRangeMin       Decimal? @db.Decimal(20, 2)
  reportedRangeMax       Decimal? @db.Decimal(20, 2)
  estimatedRangeMidpoint Decimal? @db.Decimal(20, 2)

  filingUrl            String?
  externalId           String // id from the source file/import — dedup key component
  sourceName           String // "house_official" | "senate_official" | "manual_import" | "sample_fixture"
  isLiveOfficialSource Boolean @default(false)

  firstSeenAt    DateTime @default(now())
  lastUpdatedAt  DateTime @updatedAt
  parsingVersion Int      @default(1)
  rawPayload     Json?

  resolvedCompany Company? @relation(fields: [resolvedCompanyId], references: [id])

  @@unique([sourceName, externalId])
  @@index([resolvedCompanyId, transactionDate])
}

enum IngestionSource {
  SEC_INSIDER
  USASPENDING
  CONGRESS_HOUSE
  CONGRESS_SENATE
  MARKET_PRICE
  ENTITY_RESOLUTION
  SIGNAL_SCORE
}

enum IngestionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

model SourceIngestionRun {
  id          String             @id @default(uuid()) @db.Uuid
  source      IngestionSource
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  status      IngestionRunStatus @default(RUNNING)

  recordsFetched       Int     @default(0)
  recordsInserted      Int     @default(0)
  recordsUpdated       Int     @default(0)
  recordsSkipped       Int     @default(0)
  parsingFailures      Int     @default(0)
  rateLimitFailures    Int     @default(0)
  lastSuccessfulCursor String?
  errorSummary         String?

  errors SourceIngestionError[]

  @@index([source, startedAt])
}

model SourceIngestionError {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @db.Uuid
  recordId  String?
  errorType String
  message   String
  createdAt DateTime @default(now())

  run SourceIngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// One row per (company, window, computedAt) — a point-in-time Evidence
// Score. Kept even after recomputation (never updated in place) so Phase
// 3's "how did prior signals perform" evaluation has real history to
// measure against, not just the current score.
model SignalSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  windowDays Int
  computedAt DateTime @default(now())

  totalScore              Int
  insiderScore            Int
  governmentContractScore Int
  congressScore           Int
  convergenceBonus        Int
  confidence              Decimal  @db.Decimal(3, 2)
  categoriesMatched       Int
  explanations            String[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, windowDays, computedAt])
  @@index([windowDays, totalScore])
}
