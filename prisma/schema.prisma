// StockLens data model.
// Design rationale: docs/phase-0/04-database-design.md and docs/phase-0/05-prisma-schema.md
// Connection URLs live in prisma.config.ts (Prisma 7) — see .agents/skills/prisma-upgrade-v7.
//
// Deviation from the Phase 0 design doc: Company.ticker uses a plain unique
// String instead of `citext`, to avoid requiring a Postgres extension during
// initial scaffolding. Normalization (uppercase, trimmed) is enforced at the
// application layer (features/companies/server) before every read/write.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identity & tenancy
// ─────────────────────────────────────────────────────────────
model User {
  id          String   @id @db.Uuid // mirrors auth.users.id
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  memberships WorkspaceMember[]
  auditLogs   AuditLog[]
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  members         WorkspaceMember[]
  portfolios      Portfolio[]
  theses          Thesis[]
  earningsReviews EarningsReview[]
  alertRules      AlertRule[]
  aiSummaries     AISummary[]
  auditLogs       AuditLog[]
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Portfolios & positions
// ─────────────────────────────────────────────────────────────
enum PortfolioSource {
  MANUAL
  CSV_IMPORT
  ROBINHOOD_SYNC
}

model Portfolio {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  name        String
  source      PortfolioSource @default(MANUAL)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  holdings            Holding[]
  transactions        Transaction[]
  brokerageConnection BrokerageConnection?
  csvImportJobs       CsvImportJob[]

  @@index([workspaceId])
}

model Holding {
  id               String   @id @default(uuid()) @db.Uuid
  portfolioId      String   @db.Uuid
  companyId        String   @db.Uuid
  quantity         Decimal  @db.Decimal(20, 6)
  averageCost      Decimal  @db.Decimal(20, 4)
  // Cumulative realized P&L across the full transaction history — see
  // computeHoldingAggregate. Not tax-authoritative; see disclaimers.
  realizedGainLoss Decimal  @default(0) @db.Decimal(20, 4)
  updatedAt        DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id])
  thesis    Thesis?

  @@unique([portfolioId, companyId])
  @@index([companyId])
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  SPLIT
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  portfolioId String          @db.Uuid
  companyId   String          @db.Uuid
  type        TransactionType
  quantity    Decimal         @db.Decimal(20, 6)
  price       Decimal         @db.Decimal(20, 4)
  fees        Decimal?        @db.Decimal(20, 4)
  occurredAt  DateTime
  source      PortfolioSource @default(MANUAL)
  externalId  String? // broker/CSV-provided id, for idempotent re-sync/re-import
  createdAt   DateTime        @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([portfolioId, externalId])
  @@index([portfolioId, occurredAt])
}

enum BrokerageConnectionStatus {
  CONNECTED
  NEEDS_REAUTH
  DISCONNECTED
  ERROR
}

model BrokerageConnection {
  id            String                    @id @default(uuid()) @db.Uuid
  portfolioId   String                    @unique @db.Uuid
  provider      String                    @default("ROBINHOOD")
  status        BrokerageConnectionStatus @default(CONNECTED)
  // Null under the MCP-assisted sync model: there is no credential for the
  // app to reference, since the app never authenticates to the brokerage
  // itself (see ROBINHOOD_MCP_SECURITY_PLAN.md). Reserved for a future
  // self-service connect flow, which would populate a real secret-store
  // reference here — never the credential itself.
  credentialRef String?
  scopes        String[] // e.g. ["read:positions", "read:transactions"] — write scopes never issued
  lastSyncedAt  DateTime?
  createdAt     DateTime                  @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

enum CsvImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CsvImportJob {
  id            String          @id @default(uuid()) @db.Uuid
  portfolioId   String          @db.Uuid
  status        CsvImportStatus @default(PENDING)
  storagePath   String // Supabase Storage object path
  columnMapping Json
  rowsTotal     Int?
  rowsSucceeded Int?
  rowsFailed    Int?
  errorDetail   Json?
  createdAt     DateTime        @default(now())
  completedAt   DateTime?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

// ─────────────────────────────────────────────────────────────
enum CompanyAssetType {
  STOCK
  ETF
}

// Company & market data — GLOBAL reference data (no workspaceId)
// ─────────────────────────────────────────────────────────────
model Company {
  id        String           @id @default(uuid()) @db.Uuid
  ticker    String           @unique // normalized (uppercase, trimmed) at the application layer
  cik       String?          @unique // null for ETFs — SEC's operating-company ticker list doesn't cover funds
  name      String
  assetType CompanyAssetType @default(STOCK)
  exchange  String?
  sector    String?
  industry  String?
  updatedAt DateTime         @updatedAt

  holdings            Holding[]
  transactions        Transaction[]
  priceSnapshots      PriceSnapshot[]
  financialStatements FinancialStatement[]
  secFilings          SecFiling[]
  earningsEvents      EarningsEvent[]
  theses              Thesis[]
  metricTemplate      CompanyMetricTemplate?
}

model PriceSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  asOfDate  DateTime @db.Date
  open      Decimal? @db.Decimal(20, 4)
  high      Decimal? @db.Decimal(20, 4)
  low       Decimal? @db.Decimal(20, 4)
  close     Decimal  @db.Decimal(20, 4)
  volume    BigInt?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, asOfDate])
}

enum FiscalPeriod {
  Q1
  Q2
  Q3
  Q4
  FY
}

model FinancialStatement {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @db.Uuid
  fiscalYear       Int
  fiscalPeriod     FiscalPeriod
  revenue          Decimal?     @db.Decimal(24, 2)
  netIncome        Decimal?     @db.Decimal(24, 2)
  grossProfit      Decimal?     @db.Decimal(24, 2)
  eps              Decimal?     @db.Decimal(10, 4)
  totalAssets      Decimal?     @db.Decimal(24, 2)
  totalLiabilities Decimal?     @db.Decimal(24, 2)
  sourceUrl        String?
  fetchedAt        DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, fiscalYear, fiscalPeriod])
}

// ─────────────────────────────────────────────────────────────
// Company-specific metric templates — curated KPIs beyond the universal
// fundamentals in FinancialStatement (e.g. Oracle's RPO growth, Meta's
// DAP, Nvidia's Data Center revenue). Templates are DATA, not application
// branches — no ticker-specific logic lives in UI components; everything
// company-specific is a row here. GLOBAL reference data like Company/
// FinancialStatement (no workspaceId, public_read RLS policy, writes via
// the service-role client) — a KPI template for Oracle describes Oracle
// objectively, it isn't one user's private data. Per-workspace template
// customization would be a future refinement if multi-user support ever
// needs it (see docs/phase-0/09-security-model.md's tenant-vs-global
// split).
// ─────────────────────────────────────────────────────────────
enum MetricTemplateSource {
  CURATED // hand-written, shipped with the app (e.g. the ORCL/META/NVDA seed templates)
  AI_PROPOSED // generated by the AI-assisted setup flow, pending or after user approval
  USER
}

model MetricDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // stable slug, e.g. "oci_revenue"
  label       String
  description String?
  unit        String // "USD" | "PERCENT" | "COUNT" | "TEXT" | ...
  createdAt   DateTime @default(now())

  templateItems CompanyMetricTemplateItem[]
}

model CompanyMetricTemplate {
  id        String               @id @default(uuid()) @db.Uuid
  companyId String               @unique @db.Uuid
  name      String
  source    MetricTemplateSource @default(CURATED)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  company Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   CompanyMetricTemplateItem[]
}

model CompanyMetricTemplateItem {
  id                 String  @id @default(uuid()) @db.Uuid
  templateId         String  @db.Uuid
  metricDefinitionId String  @db.Uuid
  displayOrder       Int     @default(0)
  /// Company-specific rationale — distinct from MetricDefinition.description,
  /// which is the generic definition shared across any template using it.
  whyItMatters       String?
  reportedIn         String? // e.g. "10-Q MD&A", "quarterly earnings deck"

  template         CompanyMetricTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  metricDefinition MetricDefinition      @relation(fields: [metricDefinitionId], references: [id])
  observations     MetricObservation[]

  @@unique([templateId, metricDefinitionId])
}

enum MetricConfidence {
  REPORTED // directly from an official filing/IR release
  ESTIMATED // derived or estimated, not a directly reported figure
  UNVERIFIED // AI-proposed or otherwise not yet confirmed against a source
}

model MetricObservation {
  id               String           @id @default(uuid()) @db.Uuid
  templateItemId   String           @db.Uuid
  fiscalYear       Int
  fiscalPeriod     FiscalPeriod
  // Kept as a string, not Decimal: some company-specific KPIs are
  // qualitative (e.g. "data-centre capacity commentary"), not numeric.
  value            String
  unit             String
  source           String? // URL or citation text
  confidence       MetricConfidence @default(REPORTED)
  isManualOverride Boolean          @default(false)
  recordedAt       DateTime         @default(now())

  templateItem CompanyMetricTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Cascade)

  @@unique([templateItemId, fiscalYear, fiscalPeriod])
  @@index([templateItemId])
}

model SecFiling {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  formType        String // "10-K", "10-Q", "8-K", …
  accessionNumber String    @unique
  filedAt         DateTime
  periodOfReport  DateTime?
  documentUrl     String
  fetchedAt       DateTime  @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aiSummaries AISummary[]

  @@index([companyId, filedAt])
}

model EarningsEvent {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String       @db.Uuid
  fiscalYear      Int
  fiscalPeriod    FiscalPeriod
  reportDate      DateTime
  epsEstimate     Decimal?     @db.Decimal(10, 4)
  epsActual       Decimal?     @db.Decimal(10, 4)
  revenueEstimate Decimal?     @db.Decimal(24, 2)
  revenueActual   Decimal?     @db.Decimal(24, 2)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviews     EarningsReview[]
  aiSummaries AISummary[]

  @@unique([companyId, fiscalYear, fiscalPeriod])
  @@index([companyId, reportDate])
}

// ─────────────────────────────────────────────────────────────
// Thesis & review — tenant-owned
// ─────────────────────────────────────────────────────────────
enum ConvictionLevel {
  LOW
  MEDIUM
  HIGH
}

enum ThesisStatus {
  ACTIVE
  NEEDS_REVIEW
  CLOSED
}

model Thesis {
  id                      String          @id @default(uuid()) @db.Uuid
  workspaceId             String          @db.Uuid
  companyId               String          @db.Uuid
  holdingId               String?         @unique @db.Uuid
  title                   String          @default("")
  summary                 String
  // "Why the market may be mispricing the company" — the core contrarian
  // claim, kept distinct from `summary` (which is the general thesis
  // overview) per the spec's explicit field list.
  whyMispriced            String?
  expectedDrivers         String?
  risks                   String?
  keyAssumptions          String?
  timeHorizon             String? // free text ("12-24 months") — horizons vary too much for a fixed enum
  valuationNotes          String?
  positionSizingRationale String?
  reasonsToAdd            String?
  reasonsToHold           String?
  reasonsToTrim           String?
  reasonsToExit           String?
  invalidationConditions  String?
  nextReviewDate          DateTime?       @db.Date
  sources                 String[]        @default([])
  conviction              ConvictionLevel @default(MEDIUM)
  targetPrice             Decimal?        @db.Decimal(20, 4)
  status                  ThesisStatus    @default(ACTIVE)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company          @relation(fields: [companyId], references: [id])
  holding     Holding?         @relation(fields: [holdingId], references: [id])
  revisions   ThesisRevision[]
  aiSummaries AISummary[]

  @@index([workspaceId])
  @@index([companyId])
}

enum ThesisRevisionTrigger {
  MANUAL_EDIT
  EARNINGS_REVIEW
  FILING_REVIEW
}

// Immutable full snapshot of a Thesis at one point in time — never updated
// or deleted after creation. Every edit to Thesis inserts one of these
// first, so "what changed between versions" is always answerable by diffing
// two rows, not by reconstructing history from an audit log.
model ThesisRevision {
  id                      String                @id @default(uuid()) @db.Uuid
  thesisId                String                @db.Uuid
  title                   String                @default("")
  summary                 String
  whyMispriced            String?
  expectedDrivers         String?
  risks                   String?
  keyAssumptions          String?
  timeHorizon             String?
  valuationNotes          String?
  positionSizingRationale String?
  reasonsToAdd            String?
  reasonsToHold           String?
  reasonsToTrim           String?
  reasonsToExit           String?
  invalidationConditions  String?
  nextReviewDate          DateTime?             @db.Date
  sources                 String[]              @default([])
  conviction              ConvictionLevel
  targetPrice             Decimal?              @db.Decimal(20, 4)
  trigger                 ThesisRevisionTrigger @default(MANUAL_EDIT)
  createdAt               DateTime              @default(now())

  thesis         Thesis          @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  earningsReview EarningsReview?

  @@index([thesisId, createdAt])
}

model EarningsReview {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  earningsEventId   String   @db.Uuid
  notes             String
  affectsThesis     Boolean  @default(false)
  spawnedRevisionId String?  @unique @db.Uuid
  createdAt         DateTime @default(now())

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  earningsEvent   EarningsEvent   @relation(fields: [earningsEventId], references: [id], onDelete: Cascade)
  spawnedRevision ThesisRevision? @relation(fields: [spawnedRevisionId], references: [id])

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// Alerts — tenant-owned
// ─────────────────────────────────────────────────────────────
enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  NEW_FILING
  UPCOMING_EARNINGS
  THESIS_STALE
}

model AlertRule {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  companyId   String?   @db.Uuid
  thesisId    String?   @db.Uuid
  type        AlertType
  config      Json // e.g. { "threshold": 150.00 } or { "daysBefore": 3 }
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    AlertEvent[]

  @@index([workspaceId])
  @@index([active, type])
}

enum AlertDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum AlertChannel {
  EMAIL
  IN_APP
}

model AlertEvent {
  id             String              @id @default(uuid()) @db.Uuid
  alertRuleId    String              @db.Uuid
  payload        Json
  channel        AlertChannel
  deliveryStatus AlertDeliveryStatus @default(PENDING)
  firedAt        DateTime            @default(now())
  deliveredAt    DateTime?

  alertRule AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)

  @@index([alertRuleId, firedAt])
}

// ─────────────────────────────────────────────────────────────
// AI summaries — tenant-owned, content-addressed cache
// ─────────────────────────────────────────────────────────────
enum AISummarySubjectType {
  SEC_FILING
  EARNINGS_EVENT
  THESIS
}

model AISummary {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String               @db.Uuid
  subjectType     AISummarySubjectType
  secFilingId     String?              @db.Uuid
  earningsEventId String?              @db.Uuid
  thesisId        String?              @db.Uuid
  inputHash       String // hash(subject content + prompt version + model id)
  model           String
  promptVersion   String
  content         String
  createdAt       DateTime             @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  secFiling     SecFiling?     @relation(fields: [secFilingId], references: [id])
  earningsEvent EarningsEvent? @relation(fields: [earningsEventId], references: [id])
  thesis        Thesis?        @relation(fields: [thesisId], references: [id])

  @@unique([subjectType, secFilingId, earningsEventId, thesisId, inputHash])
}

// ─────────────────────────────────────────────────────────────
// Cross-cutting
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  action      String // "BROKERAGE_CONNECTED", "WORKSPACE_MEMBER_ADDED", …
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([workspaceId, createdAt])
}
