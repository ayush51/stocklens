# Copy to .env and fill in real values. Never commit .env — see .gitignore.
# See docs/phase-0/09-security-model.md §2-3 for what each role/secret is for.

# Prisma / Postgres (Supabase) ------------------------------------------------
# Three roles, three connection strings — see the rls_and_roles migration.
#
# app_user: RLS-constrained. Used by the default Prisma client at runtime for
# all request-scoped queries (via src/lib/db/rls.ts#forUser). Pooled
# (transaction mode, port 6543), routed through Supavisor — note the
# "role.project-ref" username format, required for any non-`postgres` role.
DATABASE_URL="postgresql://app_user.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# postgres (owner): Prisma CLI only (migrate/introspect/studio) — never
# imported by app runtime code. Session-mode pooler (port 5432), not the
# direct host — the direct host is IPv6-only on Supabase's free tier, which
# most environments (including this one and Vercel) can't reach.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# service_role_app: BYPASSRLS. Used only by trusted system code (background
# jobs, seed scripts) that isn't acting on behalf of one specific user's
# request — see src/lib/db/prisma-service.ts. Never import this to serve a
# user-triggered request.
SERVICE_DATABASE_URL="postgresql://service_role_app.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Auth ----------------------------------------------------------------
# Safe to expose to the browser (NEXT_PUBLIC_ prefix) — see src/lib/env.client.ts.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
# Server-only. Never expose to the client bundle, never log it.
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"
