# Copy to .env and fill in real values. Never commit .env — see .gitignore.
# See docs/phase-0/09-security-model.md §2-3 for what each role/secret is for.

# Prisma / Postgres (Supabase) ------------------------------------------------
# Three roles, three connection strings — see the rls_and_roles migration.
#
# app_user: RLS-constrained. Used by the default Prisma client at runtime for
# all request-scoped queries (via src/lib/db/rls.ts#forUser). Pooled
# (transaction mode, port 6543), routed through Supavisor — note the
# "role.project-ref" username format, required for any non-`postgres` role.
DATABASE_URL="postgresql://app_user.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# postgres (owner): Prisma CLI only (migrate/introspect/studio) — never
# imported by app runtime code. Session-mode pooler (port 5432), not the
# direct host — the direct host is IPv6-only on Supabase's free tier, which
# most environments (including this one and Vercel) can't reach.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# service_role_app: BYPASSRLS. Used only by trusted system code (background
# jobs, seed scripts) that isn't acting on behalf of one specific user's
# request — see src/lib/db/prisma-service.ts. Never import this to serve a
# user-triggered request.
SERVICE_DATABASE_URL="postgresql://service_role_app.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Auth ----------------------------------------------------------------
# Safe to expose to the browser (NEXT_PUBLIC_ prefix) — see src/lib/env.client.ts.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
# Server-only. Never expose to the client bundle, never log it.
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# Market data (quotes, historical prices, corporate actions, earnings dates) -
# Optional. Without it, src/features/market-data falls back to the
# fail-closed UnavailableMarketDataProvider — quotes show as "unavailable",
# nothing crashes. Free-tier key: https://finnhub.io/register.
FINNHUB_API_KEY=""

# Provider-level kill switch: flip to "false" to force the app into its
# fail-closed unavailable-provider state without removing the API key
# above (useful during a rate-limit/cost/data-quality incident — flipping
# back on doesn't require re-entering the secret). Defaults to "true".
MARKET_DATA_PROVIDER_ENABLED="true"

# Kill switch for the unofficial Yahoo Finance chart-API fallback used for
# historical prices when Finnhub's own endpoint can't serve a free-tier
# request. Flip to "false" without a code change/deploy if that endpoint
# ever becomes unreliable or blocked. Defaults to "true".
YAHOO_HISTORICALS_FALLBACK_ENABLED="true"

# AI-generated filing/financial summaries, KPI extraction, and the portfolio
# chat assistant — see src/features/ai-summaries. Optional: absent means
# those features fall back to a fail-closed unavailable provider rather than
# crashing. Free-tier key: https://aistudio.google.com/apikey.
GEMINI_API_KEY=""
