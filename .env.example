# Copy to .env and fill in real values. Never commit .env — see .gitignore.
# See docs/phase-0/09-security-model.md §4 for what each secret is for.

# Prisma / Postgres (Supabase) ------------------------------------------------
# Pooled (pgbouncer, port 6543) — used by the running app at runtime.
DATABASE_URL="postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) — used only by the Prisma CLI (migrate/introspect/studio),
# which pgbouncer's transaction-pooling mode can't support.
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase Auth ----------------------------------------------------------------
# Safe to expose to the browser (NEXT_PUBLIC_ prefix) — see src/lib/env.client.ts.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
# Server-only. Never expose to the client bundle, never log it.
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"
